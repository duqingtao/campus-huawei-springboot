<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.assess.mapper.AssessRegulationMapper">

	<resultMap type="com.ruoyi.assess.domain.AssessRegulation" id="AssessRegulationResult">
		<id     property="regulationId"    column="regulation_id"    />
		<result property="regulationNo"    column="regulation_no"    />
		<result property="title"           column="title"            />
		<result property="publishDate"     column="publish_date"     />
		<result property="effectiveDate"   column="effective_date"   />
		<result property="expireDate"      column="expire_date"      />
		<result property="status"          column="status"           />
		<result property="versionNum"      column="version_num"      />
		<result property="content"         column="content"          />
		<result property="createBy"        column="create_by"        />
		<result property="createTime"      column="create_time"      />
		<result property="updateBy"        column="update_by"        />
		<result property="updateTime"      column="update_time"      />
		<result property="delFlag"         column="del_flag"         />
		<result property="remark"          column="remark"           />
	</resultMap>

	<sql id="selectRegulationVo">
        select regulation_id, regulation_no, title, publish_date, effective_date, expire_date,
               status, version_num, content, create_by, create_time, update_by, update_time,
               del_flag, remark
        from assess_regulation
    </sql>

	<select id="selectRegulationList" parameterType="com.ruoyi.assess.domain.AssessRegulation" resultMap="AssessRegulationResult">
		<include refid="selectRegulationVo"/>
		<where>
			del_flag = '0'
			<if test="regulationNo != null and regulationNo != ''">
				AND regulation_no like concat('%', #{regulationNo}, '%')
			</if>
			<if test="title != null and title != ''">
				AND title like concat('%', #{title}, '%')
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by regulation_id desc
	</select>

	<select id="selectRegulationById" parameterType="Long" resultMap="AssessRegulationResult">
		<include refid="selectRegulationVo"/>
		where regulation_id = #{regulationId} and del_flag = '0'
	</select>

	<select id="checkRegulationNoUnique" parameterType="String" resultMap="AssessRegulationResult">
		<include refid="selectRegulationVo"/>
		where regulation_no = #{regulationNo} and del_flag = '0' limit 1
	</select>

	<insert id="insertRegulation" parameterType="com.ruoyi.assess.domain.AssessRegulation" useGeneratedKeys="true" keyProperty="regulationId">
		insert into assess_regulation
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="regulationNo != null and regulationNo != ''">regulation_no,</if>
			<if test="title != null and title != ''">title,</if>
			<if test="publishDate != null">publish_date,</if>
			<if test="effectiveDate != null">effective_date,</if>
			<if test="expireDate != null">expire_date,</if>
			<if test="status != null and status != ''">status,</if>
			<if test="versionNum != null">version_num,</if>
			<if test="content != null and content != ''">content,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			<if test="remark != null and remark != ''">remark,</if>
			create_time,
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="regulationNo != null and regulationNo != ''">#{regulationNo},</if>
			<if test="title != null and title != ''">#{title},</if>
			<if test="publishDate != null">#{publishDate},</if>
			<if test="effectiveDate != null">#{effectiveDate},</if>
			<if test="expireDate != null">#{expireDate},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="versionNum != null">#{versionNum},</if>
			<if test="content != null and content != ''">#{content},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
			sysdate(),
		</trim>
	</insert>

	<update id="updateRegulation" parameterType="com.ruoyi.assess.domain.AssessRegulation">
		update assess_regulation
		<set>
			<if test="regulationNo != null and regulationNo != ''">regulation_no = #{regulationNo},</if>
			<if test="title != null and title != ''">title = #{title},</if>
			<if test="publishDate != null">publish_date = #{publishDate},</if>
			<if test="effectiveDate != null">effective_date = #{effectiveDate},</if>
			<if test="expireDate != null">expire_date = #{expireDate},</if>
			<if test="status != null and status != ''">status = #{status},</if>
			<if test="versionNum != null">version_num = #{versionNum},</if>
			<if test="content != null">content = #{content},</if>
			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
			<if test="remark != null">remark = #{remark},</if>
			update_time = sysdate(),
		</set>
		where regulation_id = #{regulationId}
	</update>

	<update id="deleteRegulationById" parameterType="Long">
		update assess_regulation set del_flag = '2' where regulation_id = #{regulationId}
	</update>

	<update id="deleteRegulationByIds" parameterType="Long">
		update assess_regulation set del_flag = '2' where regulation_id in
		<foreach item="regulationId" collection="array" open="(" separator="," close=")">
			#{regulationId}
		</foreach>
	</update>

</mapper>
