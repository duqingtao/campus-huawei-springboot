<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.assess.mapper.AssessRuleConfigMapper">

	<resultMap type="com.ruoyi.assess.domain.AssessRuleConfig" id="AssessRuleConfigResult">
		<id     property="ruleId"          column="rule_id"          />
		<result property="regulationId"    column="regulation_id"    />
		<result property="ruleName"        column="rule_name"        />
		<result property="ruleType"        column="rule_type"        />
		<result property="ruleDesc"        column="rule_desc"        />
		<result property="ruleCondition"   column="rule_condition"   />
		<result property="ruleAction"      column="rule_action"      />
		<result property="priority"        column="priority"         />
		<result property="status"          column="status"           />
		<result property="createBy"        column="create_by"        />
		<result property="createTime"      column="create_time"      />
		<result property="updateBy"        column="update_by"        />
		<result property="updateTime"      column="update_time"      />
		<result property="delFlag"         column="del_flag"         />
		<result property="remark"          column="remark"           />
	</resultMap>

	<sql id="selectRuleConfigVo">
        select rule_id, regulation_id, rule_name, rule_type, rule_desc,
               rule_condition, rule_action, priority, status,
               create_by, create_time, update_by, update_time, del_flag, remark
        from assess_rule_config
    </sql>

	<select id="selectRuleConfigList" parameterType="com.ruoyi.assess.domain.AssessRuleConfig" resultMap="AssessRuleConfigResult">
		<include refid="selectRuleConfigVo"/>
		<where>
			del_flag = '0'
			<if test="regulationId != null">
				AND regulation_id = #{regulationId}
			</if>
			<if test="ruleName != null and ruleName != ''">
				AND rule_name like concat('%', #{ruleName}, '%')
			</if>
			<if test="ruleType != null and ruleType != ''">
				AND rule_type = #{ruleType}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by priority asc, rule_id desc
	</select>

	<select id="selectRuleConfigById" parameterType="Long" resultMap="AssessRuleConfigResult">
		<include refid="selectRuleConfigVo"/>
		where rule_id = #{ruleId} and del_flag = '0'
	</select>

	<insert id="insertRuleConfig" parameterType="com.ruoyi.assess.domain.AssessRuleConfig" useGeneratedKeys="true" keyProperty="ruleId">
		insert into assess_rule_config
		<trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="regulationId != null">regulation_id,</if>
			<if test="ruleName != null and ruleName != ''">rule_name,</if>
			<if test="ruleType != null and ruleType != ''">rule_type,</if>
			<if test="ruleDesc != null and ruleDesc != ''">rule_desc,</if>
			<if test="ruleCondition != null and ruleCondition != ''">rule_condition,</if>
			<if test="ruleAction != null and ruleAction != ''">rule_action,</if>
			<if test="priority != null">priority,</if>
			<if test="status != null and status != ''">status,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			<if test="remark != null and remark != ''">remark,</if>
			create_time,
		</trim>
		<trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="regulationId != null">#{regulationId},</if>
			<if test="ruleName != null and ruleName != ''">#{ruleName},</if>
			<if test="ruleType != null and ruleType != ''">#{ruleType},</if>
			<if test="ruleDesc != null and ruleDesc != ''">#{ruleDesc},</if>
			<if test="ruleCondition != null and ruleCondition != ''">#{ruleCondition},</if>
			<if test="ruleAction != null and ruleAction != ''">#{ruleAction},</if>
			<if test="priority != null">#{priority},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
			sysdate(),
		</trim>
	</insert>

	<update id="updateRuleConfig" parameterType="com.ruoyi.assess.domain.AssessRuleConfig">
		update assess_rule_config
		<set>
			<if test="regulationId != null">regulation_id = #{regulationId},</if>
			<if test="ruleName != null and ruleName != ''">rule_name = #{ruleName},</if>
			<if test="ruleType != null and ruleType != ''">rule_type = #{ruleType},</if>
			<if test="ruleDesc != null">rule_desc = #{ruleDesc},</if>
			<if test="ruleCondition != null">rule_condition = #{ruleCondition},</if>
			<if test="ruleAction != null">rule_action = #{ruleAction},</if>
			<if test="priority != null">priority = #{priority},</if>
			<if test="status != null and status != ''">status = #{status},</if>
			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
			<if test="remark != null">remark = #{remark},</if>
			update_time = sysdate(),
		</set>
		where rule_id = #{ruleId}
	</update>

	<update id="deleteRuleConfigByIds" parameterType="Long">
		update assess_rule_config set del_flag = '2' where rule_id in
		<foreach item="ruleId" collection="array" open="(" separator="," close=")">
			#{ruleId}
		</foreach>
	</update>

	<select id="selectEnabledRuleByRegulationId" parameterType="Long" resultMap="AssessRuleConfigResult">
		<include refid="selectRuleConfigVo"/>
		where regulation_id = #{regulationId} and status = '1' and del_flag = '0'
		order by priority asc
	</select>

</mapper>
